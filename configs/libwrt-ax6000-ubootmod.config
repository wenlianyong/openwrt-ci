CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_mi-router-ax6000=y
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq50xx"
CONFIG_TARGET_PROFILE="DEVICE_xiaomi_mi-router-ax6000"

# 内核模块 核心目标：TUN
CONFIG_PACKAGE_kmod-tun=y

# WIFI配置，修复hostapd编译报错
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-full-openssl is not set
# CONFIG_PACKAGE_hostapd is not set

# LuCI基础网页管理
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-upnp=y

# 网络基础组件 fw4防火墙
CONFIG_PACKAGE_fw4=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y

# 基础工具集
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_tcpdump=y

# 包管理器 APK (25.12分支)
CONFIG_PACKAGE_apk=y

# 关闭重型插件，减轻编译负担，编译成功后再加
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_iStore is not set
# CONFIG_PACKAGE_luci-app-tailscale is not set
# CONFIG_PACKAGE_wireguard is not set
# CONFIG_PACKAGE_shadowsocks-libev is not set
# CONFIG_PACKAGE_v2raya is not set

# 文件系统
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PERSISTENT=0
CONFIG_TARGET_IMAGES_GZIP=y

# 禁用无用语言
CONFIG_LUCI_LANG_ja=n
CONFIG_LUCI_LANG_ru=n
CONFIG_LUCI_LANG_ko=n
CONFIG_LUCI_LANG_es=n
CONFIG_LUCI_LANG_fr=n
CONFIG_LUCI_LANG_it=n
CONFIG_LUCI_LANG_pt=n
CONFIG_LUCI_LANG_pl=n
CONFIG_LUCI_LANG_de=n
CONFIG_LUCI_LANG_ca=n
CONFIG_LUCI_LANG_uk=n
CONFIG_LUCI_LANG_hu=n
CONFIG_LUCI_LANG_cs=n
CONFIG_LUCI_LANG_sv=n
CONFIG_LUCI_LANG_zh_Hans=y
